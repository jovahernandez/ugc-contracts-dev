# ===========================================
# CONFIGURACIÓN DE SERVIDOR
# ===========================================

# Puerto del servidor (Render lo configura automáticamente)
PORT=3000

# URL pública del servidor (REQUERIDO en producción)
# Para Render: https://tu-app.onrender.com
# Para Railway: https://tu-app.railway.app
# Para desarrollo local: http://localhost:3000
PUBLIC_BASE_URL=https://ugc-contracts-dev.onrender.com

# Carpeta raíz de almacenamiento (opcional, default: storage)
STORAGE_ROOT=storage

# ===========================================
# HUBSPOT
# ===========================================

# Token de tu Private App de HubSpot (REQUERIDO)
# Dónde conseguirlo: Settings → Integrations → Private Apps → Tu App → "Show token"
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL base de la API de HubSpot (opcional, default: https://api.hubapi.com)
HUBSPOT_BASE_URL=https://api.hubapi.com

# ===========================================
# WEBHOOKS DE HUBSPOT
# ===========================================

# Secret para validar webhooks de HubSpot (REQUERIDO en producción)
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: Este secret DEBE ser el mismo que configuras en HubSpot
HUBSPOT_WEBHOOK_SECRET=tu-secret-super-seguro-aqui-generalo-con-el-comando-de-arriba

# ===========================================
# FIRMA DE CONTRATOS
# ===========================================

# Días de vigencia del link de firma (opcional, default: 5)
# Después de este tiempo, el link de firma expirará
SIGNATURE_EXPIRATION_DAYS=5

# ===========================================
# AUTENTICACIÓN DE API (OPCIONAL)
# ===========================================

# Token para proteger endpoints manuales como /contracts/generate
# Si no lo configuras, los endpoints estarán desprotegidos
# Los webhooks NO usan este token, usan HUBSPOT_WEBHOOK_SECRET
API_AUTH_TOKEN=tu-token-secreto-para-apis-manuales

# ===========================================
# CLOUDCONVERT (CONVERSIÓN DOCX → PDF)
# ===========================================

# API Key de CloudConvert para conversión DOCX → PDF (REQUERIDO)
# Obtén tu key en: https://cloudconvert.com/dashboard/api/v2/keys
# IMPORTANTE: Esta key es SECRETA - nunca la compartas ni la subas a git
CLOUDCONVERT_API_KEY=your-cloudconvert-api-key-here

# Modo sandbox (opcional, default: false)
# true = Usa créditos sandbox para pruebas (no cuesta, pero marca PDFs)
# false = Usa créditos reales de producción
CLOUDCONVERT_SANDBOX=false

# ===========================================
# DESARROLLO
# ===========================================

# Nivel de logs (opcional)
# Valores: error, warn, info, debug
LOG_LEVEL=info

# ===========================================
# NOTAS
# ===========================================

# 1. En producción (Render/Railway):
#    - Configura estas variables en el dashboard de tu servicio
#    - NUNCA subas el archivo .env a git
#    - Asegúrate de configurar PUBLIC_BASE_URL con tu URL real
#
# 2. En desarrollo local:
#    - Copia este archivo a .env
#    - Rellena los valores con tus credenciales de prueba
#    - El archivo .env está en .gitignore (no se subirá a git)
#
# 3. Variables REQUERIDAS en producción:
#    - HUBSPOT_PRIVATE_APP_TOKEN
#    - PUBLIC_BASE_URL
#    - HUBSPOT_WEBHOOK_SECRET (si usas webhooks)
#    - CLOUDCONVERT_API_KEY (para conversión DOCX → PDF)
#
# 4. Para generar secrets seguros:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
